{
  "name": "@sebastienrousseau/eslint-config",
  "version": "0.0.4",
  "description": "Shareable ESLint configuration adhering to modern JS/TS and 2026 standards",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "code-style",
    "linter",
    "javascript",
    "typescript"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./flat": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./legacy": {
      "types": "./index.d.ts",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "eslint-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.1"
  }
}
