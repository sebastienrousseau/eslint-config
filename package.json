{
  "name": "@sebastienrousseau/eslint-config",
  "version": "0.0.7",
  "description": "Shareable ESLint configuration adhering to modern JS/TS and 2026 standards",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "code-style",
    "linter",
    "javascript",
    "typescript"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./flat": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "eslint-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.7",
    "eslint": "10.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "configKit": {
    "shape": "array",
    "presets": [],
    "validate": "eslint-flat"
  }
}
